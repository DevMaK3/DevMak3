{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "index.js": {
      "includeFiles": "{assets/**,robots.txt,sitemap.xml,favicon.ico,google*.html}"
    }
  },
  "routes": [
    {
      "src": "/google023bde7489b7a7ab.html",
      "dest": "/google023bde7489b7a7ab.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
